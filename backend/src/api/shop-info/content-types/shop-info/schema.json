{
  "kind": "singleType",
  "collectionName": "shop_info",
  "info": {
    "singularName": "shop-info",
    "pluralName": "shop-infos",
    "displayName": "Shop Info",
    "description": "General shop information and settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "default": "A Cut Above the Rest"
    },
    "tagline": {
      "type": "string",
      "default": "Premium Grooming for the Modern Man"
    },
    "description": {
      "type": "text"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "address": {
      "type": "json",
      "default": {
        "street": "",
        "city": "",
        "state": "",
        "zip": ""
      }
    },
    "socialMedia": {
      "type": "json",
      "default": {
        "instagram": "",
        "facebook": "",
        "twitter": ""
      }
    },
    "defaultWorkingHours": {
      "type": "json",
      "default": {
        "monday": { "enabled": true, "start": "09:00", "end": "18:00" },
        "tuesday": { "enabled": true, "start": "09:00", "end": "18:00" },
        "wednesday": { "enabled": true, "start": "09:00", "end": "18:00" },
        "thursday": { "enabled": true, "start": "09:00", "end": "18:00" },
        "friday": { "enabled": true, "start": "09:00", "end": "19:00" },
        "saturday": { "enabled": true, "start": "08:00", "end": "17:00" },
        "sunday": { "enabled": false, "start": null, "end": null }
      }
    }
  }
}
