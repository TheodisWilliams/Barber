{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Barbershop services with pricing and duration"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "durationMinutes": {
      "type": "integer",
      "required": true,
      "default": 30
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "category": {
      "type": "enumeration",
      "enum": ["haircut", "shave", "styling", "specialty", "package"],
      "default": "haircut"
    },
    "barbers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::barber.barber",
      "inversedBy": "services"
    },
    "appointments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::appointment.appointment",
      "mappedBy": "service"
    }
  }
}
